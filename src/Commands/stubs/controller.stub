<?php
declare(strict_types=1);

namespace {{namespace}};

use App\Controller\AbstractController;
use App\Model\{{model}};
use App\Service\{{service}};
use {{requestNamespace}}\{{request}};
use Hyperf\Di\Annotation\Inject;

/**
  * @desc {{desc}}
  * @author {{author}} {{date}}
  */
class {{class}} extends AbstractController
{
    #[Inject]
    private {{service}} $service;

    /**
      * @desc {{desc}}列表
      * @author {{author}} {{date}}
      */
    public function index()
    {
        return $this->collection($this->service->paginate($this->request->all()));
    }

    /**
      * @desc {{desc}}详情
      * @author {{author}} {{date}}
      */
    public function show({{model}} ${{modelName}})
    {
        return $this->success(${{modelName}});
    }

    /**
      * @desc {{desc}}添加
      * @author {{author}} {{date}}
      */
    public function store({{request}} $request)
    {
        return $this->success($this->service->create($request->validated()));
    }

    /**
      * @desc {{desc}}更新
      * @author {{author}} {{date}}
      */
    public function update({{model}} ${{modelName}}, {{request}} $request)
    {
        return $this->success($this->service->update(${{modelName}}, $request->validated()));
    }

    /**
      * @desc {{desc}}删除
      * @author {{author}} {{date}}
      */
    public function destroy({{model}} ${{modelName}})
    {
        $this->service->delete(${{modelName}});

        return $this->success();
    }
}
