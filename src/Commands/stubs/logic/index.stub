<?php

declare(strict_types=1);

namespace {{namespace}};

use App\Model\{{model}};
use Goletter\Server\BaseService;
use Hyperf\Collection\Arr;

/**
  * @desc 列表
  * @author {{author}} {{date}}
  */
class {{class}} extends BaseService
{
    public function handle(array $params)
    {
        return {{model}}::query()->filter($params)->paginate((int) Arr::get($params, 'pageSize', 20));
    }
}
